# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

MONGO_PORT=27017
MONGODB_URI=mongodb://127.0.0.1:27017/mzazicare

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# At least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

RUSTFS_ENDPOINT=localhost
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_USE_SSL=false
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=mzazicare
RUSTFS_REGION=us-east-1
# Only needed when the API and the browser reach RustFS at different addresses
# (e.g. the API runs in docker). Presigned URLs are signed against this host.
# RUSTFS_PUBLIC_URL=http://localhost:9000

# Integrations — leave blank in development to use the console/sandbox stubs.
SMS_API_KEY=
# Africa's Talking: both SMS_API_KEY and SMS_USERNAME are needed to send real SMS.
# SMS_USERNAME=sandbox uses the AT sandbox. SMS_SENDER_ID is optional.
SMS_USERNAME=
SMS_SENDER_ID=
SMTP_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# MzaziCare production settings.
#
#   cp .env.example .env      (on the server, inside deploy/)
#   nano .env                 (fill in every CHANGE_ME)
#
# .env is ignored by git. NEVER commit it, never paste it into chat or email.
# Generate each secret with:   openssl rand -base64 48
# Use NEW secrets here: the development ones were exposed and must not be reused.

# ---------------- domains (used by Caddy) ----------------
API_DOMAIN=api.CHANGE_ME.me
FILES_DOMAIN=files.CHANGE_ME.me
# Let's Encrypt sends certificate warnings here.
ACME_EMAIL=CHANGE_ME@example.com

# ---------------- app ----------------
NODE_ENV=production
PORT=4000
API_PREFIX=/v1
# The frontend's address on Vercel (and your own domain if you add one). Comma-separated.
ALLOWED_ORIGINS=https://CHANGE_ME.vercel.app,https://app.CHANGE_ME.me

# ---------------- database: MongoDB Atlas ----------------
# Atlas → your cluster → Connect → Drivers. Keep "/mzazicare" as the database name.
MONGODB_URI="mongodb+srv://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME.mongodb.net/mzazicare?retryWrites=true&w=majority"

# ---------------- redis (runs on this server) ----------------
REDIS_PASSWORD=CHANGE_ME_openssl_rand

# ---------------- file storage: RustFS (runs on this server) ----------------
RUSTFS_ACCESS_KEY=CHANGE_ME_openssl_rand_hex_16
RUSTFS_SECRET_KEY=CHANGE_ME_openssl_rand
RUSTFS_BUCKET=mzazicare
RUSTFS_REGION=us-east-1
# Signed download/upload links are issued for this public address.
RUSTFS_PUBLIC_URL=https://files.CHANGE_ME.me

# ---------------- auth ----------------
JWT_SECRET=CHANGE_ME_openssl_rand
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------- audit log (U-CS 78) ----------------
# Seals every audit entry. Set it ONCE, before the first user. Changing it later
# makes every earlier entry fail verification. Keep a copy somewhere safe
# (a password manager), because without it the chain cannot be verified.
AUDIT_HMAC_SECRET=CHANGE_ME_openssl_rand

# ---------------- Verification codes by email (free) ----------------
# Without this, codes only appear in the server logs and real users cannot register.
# Gmail app password (same account as development is fine):
#   SMTP_URL=smtps://ADDRESS%40gmail.com:APPPASSWORD@smtp.gmail.com:465
# Later, with your own domain: Brevo, smtp://LOGIN:KEY@smtp-relay.brevo.com:587
SMTP_URL=CHANGE_ME_smtp_url
# SMTP_FROM=MzaziCare <no-reply@yourdomain>

# ---------------- optional: SMS (paid, Africa's Talking) ----------------
# Leave blank: codes go by email. Fill in only if you buy SMS credit.
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=

# ---------------- optional ----------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# ---------------- server jobs (backup + ML alerts, see crontab.txt) ----------------
# Trained model run used for hourly alerts (copy the folder to ml/audit-anomaly/runs/ on the server).
ML_RUN=20261105-025753_113141a_sim-v3-role-relative
# How many days of nightly backups to keep on the server.
BACKUP_KEEP_DAYS=14
